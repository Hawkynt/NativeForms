<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Hawkynt.NativeForms.Backends.MacOS</AssemblyName>
    <RootNamespace>Hawkynt.NativeForms.Backends.MacOS</RootNamespace>
    <PackageId>Hawkynt.NativeForms.Backends.MacOS</PackageId>
    <Version>1.0.0</Version>
    <Description>The macOS Cocoa backend for NativeForms. Implements native AppKit windows, controls, menus and common dialogs with CI smoke and screenshot coverage; see docs/backends.md for the remaining platform-specific limitations.</Description>
    <PackageTags>ui;winforms;gui;cross-platform;native;pinvoke;macos;cocoa;aot;trimming</PackageTags>

    <!-- Ships a .snupkg to nuget.org's symbol server, which needs a real portable PDB; this
         overrides the repo-wide Release DebugType=none (see Directory.Build.props). -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeForms.Core\NativeForms.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PackageReadmeFile names the README inside the package; it does not put it there. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
