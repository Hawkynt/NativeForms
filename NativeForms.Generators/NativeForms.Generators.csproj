<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Roslyn source generator that turns [GridEditable] models into PopulateGrid(PropertyGrid) methods.
       It must target netstandard2.0 (the analyzer contract), overriding the repo-wide net10.0 default, and
       ships as a compile-time analyzer only — no runtime assembly, so nothing reflection-based reaches an
       app. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- This generator has no package of its own: it travels inside Hawkynt.NativeForms under
         analyzers/dotnet/cs (see NativeForms.Core.csproj). Without this, the solution-wide
         `dotnet pack` tries to pack it too and fails with NU5017 — an analyzer contributes no lib/
         output, and its only PackageReference is PrivateAssets=all, so the package would be empty. -->
    <IsPackable>false</IsPackable>

    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsAotCompatible>false</IsAotCompatible>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
