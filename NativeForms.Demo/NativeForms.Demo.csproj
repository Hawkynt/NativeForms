<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Hawkynt.NativeForms.Demo</AssemblyName>
    <RootNamespace>Hawkynt.NativeForms.Demo</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- The demo is the AOT proof: it must publish clean with PublishAot=true on each platform. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The autopilot walkthrough writes GdkEvent fields through pointers, which the LibraryImport
         generator and Unsafe.AsRef both need an unsafe context for. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Binds the process to ComCtl32 version 6, which is the only way a Windows process reaches the
         themed stock controls; see the file itself. Harmless on Linux and macOS, where nothing reads
         a Win32 resource. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeForms.Core\NativeForms.Core.csproj" />
    <ProjectReference Include="..\NativeForms.Backends.Windows\NativeForms.Backends.Windows.csproj" />
    <ProjectReference Include="..\NativeForms.Backends.Gtk\NativeForms.Backends.Gtk.csproj" />
    <ProjectReference Include="..\NativeForms.Backends.MacOS\NativeForms.Backends.MacOS.csproj" />
  </ItemGroup>

</Project>
